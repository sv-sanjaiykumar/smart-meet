rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if the requester is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // users collection
    match /users/{uid} {
      // Authenticated users can read profiles (needed for directory, names, etc.)
      allow read: if isSignedIn();

      // A newly created user can write their own profile (non-admin only), or admin
      allow create: if (isSignedIn() && request.auth.uid == uid && request.resource.data.role != 'admin')
                    || isAdmin();

      // Users can update their own profile without role escalation, or admins can update any profile
      allow update: if (isSignedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role)
                    || isAdmin();

      // Only admins can delete profiles
      allow delete: if isAdmin();
    }

    // meetings collection (all authenticated users can read, students can create, staff/admins can update)
    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // notifications collection
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
